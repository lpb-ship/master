# Copy to .env.local. These credentials work only with the disposable local DB.
APP_ENV=local
APP_ORIGIN=http://127.0.0.1:3000
DATABASE_URL=postgresql://postgres:local-development-only@127.0.0.1:54322/postgres
# Remote deployments additionally require their own project ref and CA certificate.
# SUPABASE_PROJECT_REF=
# DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
