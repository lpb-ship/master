{
  "name": "seent-it-foundation",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x",
    "npm": "11.x"
  },
  "packageManager": "npm@11.19.1",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "check:config": "node --env-file-if-exists=.env.local scripts/check-config.mjs",
    "check:db": "node --env-file-if-exists=.env.local scripts/check-db.mjs",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "next": "16.4.3",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "typescript": "7.0.2"
  }
}
